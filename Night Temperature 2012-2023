// This section does not alter the annual composites.

var raw2012 = ee.Image(
  modisRaw.filterDate('2012-03-01', '2012-06-01').first()
);

var testFiltered = ee.Image(prepareMODIS(raw2012));

var rawLSTCount = raw2012
  .select('LST_Night_1km')
  .reduceRegion({

    reducer: ee.Reducer.count(),

    geometry: puneGeometry,

    crs: modisProjection,

    scale: modisScale,

    maxPixels: 1e13,

    tileScale: 8

  });

var filteredLSTCount = testFiltered.reduceRegion({

  reducer: ee.Reducer.count(),

  geometry: puneGeometry,

  crs: modisProjection,

  scale: modisScale,

  maxPixels: 1e13,

  tileScale: 8

});

var filteredLSTMean = testFiltered.reduceRegion({

  reducer: ee.Reducer.mean(),

  geometry: puneGeometry,

  crs: modisProjection,

  scale: modisScale,

  maxPixels: 1e13,

  tileScale: 8

});

print('MODIS 2012 first image:', raw2012.date());

print('MODIS 2012 raw LST pixel count:', rawLSTCount);

print('MODIS 2012 updated QA pixel count:', filteredLSTCount);

