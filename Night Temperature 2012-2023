print('MODIS CRS:', modisCRS);
print('MODIS nominal scale (m):', modisScale);


// ============================================================================
// 17. MODIS QUALITY CONTROL AND CELSIUS CONVERSION
// ============================================================================

// LST_Night_1km scale factor = 0.02 Kelvin.
// Celsius = (DN × 0.02) - 273.15.
//
// QC_Night bit interpretation:
//
// Bits 0–1: Mandatory QA
// 00 = Good quality
// 01 = Other quality (LST produced, inspect other QA bits)
// 10 = Reserved
// 11 = Not produced
//
// Bits 2–3: Data quality
// 00 = Good data quality
// 01 = Other quality
// 10 = TBD
// 11 = TBD
//
// Your observed QC_Night values:
// 17, 65, 81 -> mandatory QA 01, data quality 00
// 2          -> mandatory QA 10, data quality 00
//
// Retain mandatory QA 00 and 01 only when data quality is 00.
// This is not a strict best-quality-only filter.

function prepareMODIS(image) {

  image = ee.Image(image);

  var qa = image.select('QC_Night');

  // Extract mandatory QA bits 0–1.
  var mandatoryQA = qa.bitwiseAnd(3);

  // Extract data quality bits 2–3.
  var dataQuality = qa.rightShift(2).bitwiseAnd(3);

  // Accept mandatory QA 00 and 01.
  var acceptedMandatoryQA = mandatoryQA.lte(1);

  // Require good data quality.
  var acceptedDataQuality = dataQuality.eq(0);

  var acceptedPixels = acceptedMandatoryQA
    .and(acceptedDataQuality);

  var lstCelsius = image
    .select('LST_Night_1km')
    .multiply(0.02)
    .subtract(273.15)
    .rename('LST_Night_C');

  return lstCelsius
    .updateMask(acceptedPixels)
    .copyProperties(image, ['system:time_start']);

}


// ============================================================================
// 18. FILTER MODIS OBSERVATIONS FOR MARCH–MAY
// ============================================================================

function getMODISSeasonCollection(year) {

  year = ee.Number(year);

  var start = ee.Date.fromYMD(year, 3, 1);
  var end = ee.Date.fromYMD(year, 6, 1);

  return modisRaw
    .filterDate(start, end)
    .map(prepareMODIS);

}


// ============================================================================
// 19. CREATE ANNUAL MODIS NIGHTTIME LST COMPOSITES
// ============================================================================

function createMODISAnnualComposite(year) {

  year = ee.Number(year);

  var annualCollection = getMODISSeasonCollection(year);

  var annualMean = annualCollection
    .mean()
    .rename('LST_Night_C')
    .setDefaultProjection(modisProjection)
    .clip(puneGeometry);

  return annualMean.set({

    Year: year,

    Image_Count: annualCollection.size(),

    Season: 'March-May',

    Dataset: 'MODIS Terra MOD11A1.061',

    QA_Filter:
      'Mandatory QA 00 or 01; data quality bits 2-3 equal 00'

  });

}

var modisAnnualImages = ee.ImageCollection.fromImages(
  years.map(createMODISAnnualComposite)
);

