// ============================================================================
// 3. LOAD ERA5-LAND HOURLY DATA
// ============================================================================

var era5Hourly = ee.ImageCollection('ECMWF/ERA5_LAND/HOURLY')
  .select('temperature_2m');

var firstEra5Image = ee.Image(era5Hourly.first());

var era5Projection = firstEra5Image
  .select('temperature_2m')
  .projection();

var era5Scale = era5Projection.nominalScale();

print('ERA5 band names:', firstEra5Image.bandNames());
print('ERA5 native projection:', era5Projection);
print('ERA5 nominal scale (m):', era5Scale);


// ============================================================================
// 4. SELECT NIGHTTIME ERA5 OBSERVATIONS
// ============================================================================

// India Standard Time = UTC + 5 hours 30 minutes.
//
// 22:00 UTC = 03:30 IST next day.
// 23:00 UTC = 04:30 IST next day.
// 00:00 UTC = 05:30 IST same day.
//
// March–May has 92 days.
// Expected observations = 92 × 3 = 276.

function getNighttimeCollection(year) {

  year = ee.Number(year);

  var localStart = ee.Date.fromYMD(year, 3, 1);
  var localEnd = ee.Date.fromYMD(year, 6, 1);

  var utcStart = localStart.advance(-330, 'minute');
  var utcEnd = localEnd.advance(-330, 'minute');

  return era5Hourly
    .filterDate(utcStart, utcEnd)
    .filter(
      ee.Filter.or(
        ee.Filter.calendarRange(22, 23, 'hour'),
        ee.Filter.calendarRange(0, 0, 'hour')
      )
    );
}


// ============================================================================
// 5. CREATE ANNUAL ERA5 COMPOSITES
// ============================================================================

function createAnnualComposite(year) {

  year = ee.Number(year);

  var collection = getNighttimeCollection(year);

  var annualTemperature = collection
    .mean()
    .subtract(273.15)
    .rename('temperature_C')
    .setDefaultProjection(era5Projection)
    .clip(puneGeometry);

  return annualTemperature.set({
    Year: year,
    Observation_Count: collection.size(),
    Season: 'March-May',
    Time_Window_IST: '03:30, 04:30, 05:30',
    Dataset: 'ERA5-Land HOURLY'
  });
}

var annualImages = ee.ImageCollection.fromImages(
  years.map(createAnnualComposite)
);

print('ERA5 annual composites:', annualImages);
print('ERA5 annual composite count:', annualImages.size());


