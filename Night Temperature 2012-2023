// =====================================================
// FIGURE 8: SPATIAL TREND OF NIGHTTIME MODIS LST
// Study period: 2012–2023
// Season: March–May
// =====================================================

// =====================================================
// FIGURE 8: SPATIAL TREND OF NIGHTTIME MODIS LST
// Pune District | March–May | 2012–2023
// =====================================================

// 1. Add year band to each annual MODIS composite.

// =====================================================
// FIGURE 8: SPATIAL TREND OF NIGHTTIME MODIS LST
// Pune District | March-May | 2012-2023
// =====================================================

// 1. Convert annual composites to a list.
// The collection was generated in chronological order.
var modisAnnualList = modisAnnualImages.toList(12);

// 2. Attach the correct year to each annual image.
// This avoids depending on system:time_start.
var modisAnnualWithYear = ee.ImageCollection.fromImages(
  ee.List.sequence(0, 11).map(function(index) {

    index = ee.Number(index);

    var image = ee.Image(modisAnnualList.get(index));

    var year = index.add(2012);

    var lst = image.select('LST_Night_C');

    var yearBand = ee.Image.constant(year)
      .rename('year')
      .toFloat()
      .updateMask(lst.mask());

    return lst.addBands(yearBand);
  })
);

// 3. Calculate pixel-wise linear regression.
// X = Year; Y = Nighttime LST.
var modisTrend = modisAnnualWithYear
  .select(['year', 'LST_Night_C'])
  .reduce(ee.Reducer.linearFit());

// 4. Extract annual trend slope.
var modisSlope = modisTrend.select('scale')
  .rename('MODIS_Night_LST_Trend_C_per_Year')
  .clip(puneGeometry);

// 5. Calculate fitted change over 11 years.
var modisChange = modisSlope
  .multiply(11)
  .rename('MODIS_Night_LST_Fitted_Change_2012_2023_C')
  .clip(puneGeometry);

// 6. Visualization parameters.
var trendVis = {
  min: -0.15,
  max: 0.15,
  palette: [
    '313695',
    '74add1',
    'ffffbf',
    'f46d43',
    'a50026'
  ]
};

var changeVis = {
  min: -1.65,
  max: 1.65,
  palette: [
    '313695',
    '74add1',
    'ffffbf',
    'f46d43',
    'a50026'
  ]
};

// 7. Display Figure 8.
Map.addLayer(
  modisSlope,
  trendVis,
  'Figure 8 - MODIS Nighttime LST Spatial Trend',
  true
);

// 8. Display fitted 11-year change.
Map.addLayer(
  modisChange,
  changeVis,
  'MODIS Nighttime LST Fitted Change 2012-2023',
  false
);

// 9. Print results.
print(
  'FIGURE 8: MODIS spatial trend image:',
  modisSlope
);

print(
  'FIGURE 8: Mean spatial trend (°C/year):',
  modisSlope.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: puneGeometry,
    crs: modisProjection,
    scale: modisProjection.nominalScale(),
    maxPixels: 1e13,
    tileScale: 8
  })
);

print(
  'FIGURE 8: Mean fitted 11-year change (°C):',
  modisChange.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: puneGeometry,
    crs: modisProjection,
    scale: modisProjection.nominalScale(),
    maxPixels: 1e13,
    tileScale: 8
  })
);

// 10. Export spatial trend.
Export.image.toDrive({
  image: modisSlope,
  description: 'Figure_8_MODIS_Nighttime_LST_Trend_2012_2023',
  folder: 'Pune_Nighttime_Thermal_Research',
  fileNamePrefix: 'Figure_8_MODIS_Nighttime_LST_Trend_2012_2023',
  region: puneGeometry,
  crs: modisProjection.crs(),
  scale: modisProjection.nominalScale(),
  maxPixels: 1e13
});

// 11. Export fitted change.
Export.image.toDrive({
