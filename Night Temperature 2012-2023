          sharedInputs: true
        }),

      geometry: puneGeometry,

      crs: modisProjection,

      scale: modisScale,

      maxPixels: 1e13,

      tileScale: 8

    });

    return ee.Feature(null, {

      Year: year,

      Mean_Nighttime_LST_C:
        stats.get('LST_Night_C_mean'),

      Minimum_Spatial_LST_C:
        stats.get('LST_Night_C_min'),

      Maximum_Spatial_LST_C:
        stats.get('LST_Night_C_max'),

      Valid_Pixel_Count:
        stats.get('LST_Night_C_count'),

      Image_Count:
        image.get('Image_Count'),

      Season: 'March-May',

      Dataset: 'MODIS Terra MOD11A1.061',

      QA_Filter:
        'Mandatory QA 00 or 01; data quality bits 2-3 equal 00'

    });

  })
).sort('Year');

