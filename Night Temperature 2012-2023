// 12 years × 3 months = 36 monthly records.
//
// The UTC filter includes the preceding UTC calendar date
// because the 03:30 IST observation occurs at 22:00 UTC
// on the previous UTC date.

var monthNames = ee.Dictionary({
  '3': 'March',
  '4': 'April',
  '5': 'May'
});

var era5MonthlySource = era5Hourly
  .filterDate(
    '2012-02-28T18:30:00',
    '2023-05-31T18:30:00'
  )
  .filter(
    ee.Filter.or(
      ee.Filter.calendarRange(22, 23, 'hour'),
      ee.Filter.calendarRange(0, 0, 'hour')
    )
  );

print(
  'Filtered ERA5 monthly source count:',
  era5MonthlySource.size()
);


function calculateMonthlyStatistics(year, month) {

  year = ee.Number(year);
  month = ee.Number(month);

  var localStart = ee.Date.fromYMD(year, month, 1);
  var localEnd = localStart.advance(1, 'month');

  var utcStart = localStart.advance(-330, 'minute');
  var utcEnd = localEnd.advance(-330, 'minute');

  var monthlyCollection = era5MonthlySource.filterDate(
    utcStart,
    utcEnd
  );

  var monthlyImage = monthlyCollection
    .mean()
    .subtract(273.15)
    .rename('temperature_C')
    .setDefaultProjection(era5Projection);

  var stats = monthlyImage.reduceRegion({

    reducer: ee.Reducer.mean()
      .combine({
        reducer2: ee.Reducer.min(),
        sharedInputs: true
      })
      .combine({
        reducer2: ee.Reducer.max(),
        sharedInputs: true
      }),

    geometry: puneGeometry,
    crs: era5Projection,
    scale: era5Scale,
    maxPixels: 1e13,
    tileScale: 8

  });

  return ee.Feature(null, {

    Year: year,
    Month_Number: month,
    Month: monthNames.get(month.format()),

    Mean_Temperature_C:
      stats.get('temperature_C_mean'),

    Minimum_Spatial_Temperature_C:
      stats.get('temperature_C_min'),

    Maximum_Spatial_Temperature_C:
      stats.get('temperature_C_max'),

    Observation_Count: monthlyCollection.size(),

    Expected_Count: localEnd.difference(
      localStart, 'day'
    ).multiply(3),

    Season: 'Pre-monsoon',
    Time_Window_IST: '03:30, 04:30, 05:30',
    Dataset: 'ERA5-Land HOURLY'

  });

}


var monthlyFeatureList = years.map(function(year) {

  return months.map(function(month) {

    return calculateMonthlyStatistics(year, month);

  });

}).flatten();

var monthlyStatistics = ee.FeatureCollection(
  monthlyFeatureList
).map(function(feature) {

  feature = ee.Feature(feature);

  return feature.set(
    'YearMonth',
    ee.Number(feature.get('Year')).multiply(100)
      .add(ee.Number(feature.get('Month_Number')))
  );

}).sort('YearMonth');

